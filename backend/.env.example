# Copy this file to .env and fill in the values. .env is gitignored — the real
# keys live there and must never be committed. Loaded automatically at startup
# by app/__init__.py (see that file). Anything already set in the real shell
# environment takes precedence over these.

# Google Maps Platform — restricted key for Places API (New) + Geocoding.
# Console: console.cloud.google.com -> APIs & Services -> Credentials.
GOOGLE_MAPS_API_KEY=

# Stage-1 retrieval source for POST /recommendations:
#   seed   (default) — the Yelp seed in SQL (offline, no key needed; the Philly
#                      dev fixture — keep this for tests/local dev)
#   google           — live Google Places Text Search for the NYC market (needs
#                      GOOGLE_MAPS_API_KEY; falls back to the seed path on error).
#                      This is the production setting.
# RECS_PROVIDER=seed

# Live-market default search center used when a recommendation request supplies no
# location (google mode only). "lat,lng"; defaults to the NYC (Manhattan) centroid
# if unset or malformed. Ignored in seed mode.
# RECS_DEFAULT_CENTER=40.7549,-73.9840

# Days a Google-sourced restaurant row is served before its fields are refreshed
# (refresh-on-read). Under Google's ~30-day content-caching ceiling; default 7.
# RESTAURANT_CACHE_TTL_DAYS=7

# Anthropic API key for the LLM ranking stage. If unset (or empty), the
# recommender falls back to the offline rating-sorted ranker — the app still runs.
ANTHROPIC_API_KEY=

# Optional: override the dev SQLite default with a Postgres DSN. Leave this line
# COMMENTED OUT to keep the default — an empty value here would override it with
# an invalid empty URL.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/restaurant
